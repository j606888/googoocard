// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DanceType {
  BACHATA
  SALSA
  ZOUK
  HUSTLE
  KIZOMBA
}

enum CardPurchaseSource {
  STAFF   // bought by 老闆/助教 (a User) on the backend
  STUDENT // self-purchased by the student (future flow; purchasedByUserId is null)
}

enum StudentCardOrigin {
  PURCHASE   // 正常購買 — 有真的金流，計入課卡營收
  CONVERSION // 由舊卡轉換而來（例：Level 1 升級 Level 2、複習卡折抵）— 不重複計入課卡營收
}

enum AttendanceSource {
  TEACHER // recorded by a teacher/助教 on the backend
  STUDENT // self check-in by the student via LIFF
}

enum LineMenuMode {
  TEACHER
  STUDENT
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  name        String
  password    String
  randomKey   String?      @unique // one-time key shown on the website; sent to the LINE bot to bind
  lineUserId  String?      @unique // bound LINE userId; used for LIFF auto-login
  classrooms  Classroom[]  @relation("OwnedClassrooms")
  memberships Membership[]
  purchasedStudentCards StudentCard[] @relation("PurchasedStudentCards")
  confirmedStudentCards StudentCard[] @relation("ConfirmedStudentCards")
  currentClassroomId Int?
  currentClassroom Classroom? @relation(fields: [currentClassroomId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Classroom {
  id          Int          @id @default(autoincrement())
  ownerId     Int
  owner       User         @relation("OwnedClassrooms", fields: [ownerId], references: [id])
  name        String
  checkinKey  String?      @unique // 現場 QR 自助簽到金鑰（貼在教室看板）；可重新產生以作廢舊看板
  memberships Membership[]
  cards       Card[]
  students    Student[]
  lessons     Lesson[]
  lessonGroups LessonGroup[]
  inviteTokens InviteToken[]
  tags        Tag[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  teachers    Teacher[]
  User        User[]
}

model Membership {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  classroomId Int
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  role        String    @default("owner")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, classroomId])
}

model Teacher {
  id          Int             @id @default(autoincrement())
  name        String
  classroomId Int
  classroom   Classroom       @relation(fields: [classroomId], references: [id])
  lessons     LessonTeacher[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Card {
  id           Int           @id @default(autoincrement())
  name         String
  price        Int
  sessions     Int
  expiredAt    DateTime?
  classroomId  Int
  studentCards StudentCard[]
  lessons      LessonCard[]
  isPracticeCard Boolean @default(false)
  danceType    DanceType?
  classroom    Classroom     @relation(fields: [classroomId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Student {
  id           Int           @id @default(autoincrement())
  name         String
  avatarUrl    String
  note         String?
  randomKey    String? @unique // public-students share link token (NOT for LINE)
  lineBindKey  String? @unique // one-time key for the LINE binding deep link
  lineUserId   String? // bound LINE userId — NOT unique: one LINE account can bind multiple students across classrooms
  classroomId  Int
  classroom    Classroom     @relation(fields: [classroomId], references: [id])
  studentCards StudentCard[]
  studentTags  StudentTag[]
  lessons      LessonStudent[]
  attendanceRecords AttendanceRecord[]
  events Event[]
  danceQualifications StudentDanceQualification[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([lineUserId])
}

model StudentDanceQualification {
  id        Int       @id @default(autoincrement())
  studentId Int
  student   Student   @relation(fields: [studentId], references: [id])
  danceType DanceType
  createdAt DateTime  @default(now())

  @@unique([studentId, danceType])
}

model StudentCard {
  id                Int      @id @default(autoincrement())
  studentId         Int
  student           Student  @relation(fields: [studentId], references: [id])
  cardId            Int
  card              Card     @relation(fields: [cardId], references: [id])
  basePrice         Int
  finalPrice        Int
  totalSessions     Int
  remainingSessions Int
  purchaseSource    CardPurchaseSource @default(STAFF)
  purchasedByUserId Int?
  purchasedBy       User?    @relation("PurchasedStudentCards", fields: [purchasedByUserId], references: [id])
  isPaid            Boolean  @default(true) // existing rows treated as paid
  paidAt            DateTime?
  paidByUserId      Int?
  paidBy            User?    @relation("ConfirmedStudentCards", fields: [paidByUserId], references: [id])
  attendanceRecords AttendanceRecord[]
  note              String?
  origin            StudentCardOrigin @default(PURCHASE)
  // 轉換鏈：欄位放在「舊卡」上指向新卡，所以多張舊卡可以合併成一張新卡
  // （複習卡 3 堂折 1 堂 Level 2 就是這個形狀）。
  convertedToId     Int?
  convertedTo       StudentCard?  @relation("StudentCardConversion", fields: [convertedToId], references: [id])
  convertedFrom     StudentCard[] @relation("StudentCardConversion")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  expiredAt         DateTime?

  @@index([convertedToId])
}

model Lesson {
  id          Int             @id @default(autoincrement())
  name        String
  classroomId Int
  classroom   Classroom       @relation(fields: [classroomId], references: [id])
  status      String          @default("inProgress")
  endAt       DateTime?
  danceType   DanceType         @default(BACHATA)
  groupId     Int?
  group       LessonGroup?    @relation(fields: [groupId], references: [id])
  teachers    LessonTeacher[]
  cards       LessonCard[]
  periods     LessonPeriod[]
  students    LessonStudent[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// Bundles recurring lesson slots that share a schedule (e.g. "週日課" holding
// several time slots taught on Sundays) so they can be browsed as one unit.
// `groupId` on Lesson is nullable — ungrouped lessons are treated as a
// virtual "未分類" bucket, no row needed here for that.
model LessonGroup {
  id          Int       @id @default(autoincrement())
  name        String
  classroomId Int
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  lessons     Lesson[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([name, classroomId])
}

model LessonTeacher {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  teacherId Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, teacherId])
}

model LessonCard {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  cardId    Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  card      Card     @relation(fields: [cardId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, cardId])
}

model LessonPeriod {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  attendanceRecords AttendanceRecord[]
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attendanceTakenAt DateTime?
}

model LessonStudent {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  studentId Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, studentId])
}

model AttendanceRecord {
  id        Int      @id @default(autoincrement())
  lessonPeriodId Int
  lessonPeriod LessonPeriod @relation(fields: [lessonPeriodId], references: [id])
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  studentCardId Int?
  studentCard StudentCard? @relation(fields: [studentCardId], references: [id])
  source    AttendanceSource @default(TEACHER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One attendance record per student per period — guards against duplicate
  // self check-ins (LIFF double-tap / concurrent submit) double-charging a card.
  @@unique([lessonPeriodId, studentId])
}

model InviteToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  classroomId Int
  classroom Classroom @relation(fields: [classroomId], references: [id])
  maxUses Int
  uses    Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id        Int      @id @default(autoincrement())
  title      String
  description String
  studentId Int
  student Student @relation(fields: [studentId], references: [id])
  resourceType String
  resourceId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id          Int          @id @default(autoincrement())
  name        String
  classroomId Int
  classroom   Classroom    @relation(fields: [classroomId], references: [id])
  studentTags StudentTag[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([name, classroomId])
}

model StudentTag {
  id        Int      @id @default(autoincrement())
  studentId Int
  tagId     Int
  student   Student  @relation(fields: [studentId], references: [id])
  tag       Tag      @relation(fields: [tagId], references: [id])
  createdAt DateTime @default(now())

  @@unique([studentId, tagId])
}

// Per-LINE-account UI state. A LINE userId can be both a teacher (User) and a
// student (Student) — this remembers which menu to show by default so switching
// to the student menu sticks across messages.
model LineAccount {
  lineUserId String       @id
  menuMode   LineMenuMode @default(TEACHER)
  // The student the account last selected in LIFF, so the LINE bot's menu shows
  // the same one. Plain id (no FK) — webhook re-validates ownership before use.
  selectedStudentId Int?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}
