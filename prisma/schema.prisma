// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CardPurchaseSource {
  STAFF // bought by 老闆/助教 (a User) on the backend
  STUDENT // self-purchased by the student (future flow; purchasedByUserId is null)
}

enum StudentCardOrigin {
  PURCHASE // 正常購買 — 有真的金流，計入課卡營收
  CONVERSION // 由舊卡轉換而來（例：Level 1 升級 Level 2、複習卡折抵）— 不重複計入課卡營收
  TRANSFER // 別的學生轉讓過來的剩餘堂數 — 沒有新金流，不計入課卡營收
}

enum AttendanceSource {
  TEACHER // recorded by a teacher/助教 on the backend
  STUDENT // self check-in by the student via LIFF
}

// 「待處理」的三類事項，也是老師端推播的種類（見 src/service/todos.ts、src/service/push.ts）。
enum TodoType {
  UNPAID_CARD // 學生自助買卡，待確認收款
  NEEDS_RENEWAL // 學生被加上「Needs Renewal」tag
  UNBOUND_ATTENDANCE // 出席紀錄沒有綁課卡
}

// 收款方式（確認付款時記錄；見 confirm-payment route）。
enum PaymentMethod {
  CASH
  TRANSFER
}

enum LineMenuMode {
  TEACHER
  STUDENT
}

model User {
  id                      Int                       @id @default(autoincrement())
  email                   String                    @unique
  name                    String
  password                String
  randomKey               String?                   @unique // one-time key shown on the website; sent to the LINE bot to bind
  lineUserId              String?                   @unique // bound LINE userId; used for LIFF auto-login
  googleSub               String?                   @unique // Google 帳號的 sub（Google 登入）
  appleSub                String?                   @unique // Apple 帳號的 sub（Sign in with Apple）
  // 刪帳號時要拿它向 Apple 撤銷授權（App Store 5.1.1(v)）。秘密：永遠不要放進 API 回應
  appleRefreshToken       String?
  appleClientId           String? // 拿到 refresh token 的 client（App 的 bundle ID 或網頁的 Services ID）
  classrooms              Classroom[]               @relation("OwnedClassrooms")
  memberships             Membership[]
  purchasedStudentCards   StudentCard[]             @relation("PurchasedStudentCards")
  confirmedStudentCards   StudentCard[]             @relation("ConfirmedStudentCards")
  confirmedDropIns        DropInCharge[]            @relation("ConfirmedDropIns")
  currentClassroomId      Int?
  currentClassroom        Classroom?                @relation(fields: [currentClassroomId], references: [id])
  // 帳號已刪除（匿名化）。非 null = decodeAuthToken 把這個人當成沒登入，
  // 其他裝置上還沒過期的 JWT 也就跟著失效（見 DELETE /api/me）。
  deletedAt               DateTime?
  pushTokens              PushToken[]
  webPushSubscriptions    WebPushSubscription[]
  notificationPreferences NotificationPreference[]
  // 連到的老師資料（每間教室最多一筆，Teacher.userId）
  teacherProfiles         Teacher[]
  enabledModules          ClassroomModule[]
  // 模組：技能樹
  skillsCreated           Skill[]
  skillChanges            SkillChange[]
  skillComments           SkillComment[]            @relation("SkillCommentAuthor")
  skillConclusions        SkillComment[]            @relation("SkillCommentConclusion")
  skillReactions          SkillCommentReaction[]
  skillMentions           SkillCommentMention[]
  skillTalkReads          SkillTalkRead[]
  // 模組：水庫
  financeRevenueOwnerOf   FinanceSetting[]          @relation("FinanceRevenueOwner")
  financeOpeningCustody   FinanceOpeningCustody[]
  financeRemittances      FinanceRemittance[]       @relation("FinanceRemittanceFrom")
  financeReviewed         FinanceRemittance[]       @relation("FinanceRemittanceReviewer")
  financeEntriesCreated   FinanceEntry[]            @relation("FinanceEntryCreator")
  financeEntriesPaid      FinanceEntry[]            @relation("FinanceEntryPayee")
  financeVerifications    FinanceLessonSettlement[] @relation("FinanceSettlementVerifier")
  financeEntryRevisions   FinanceEntryRevision[]
  financeSettingRevisions FinanceSettingRevision[]
  financeQuests           FinanceQuestDone[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
}

model Classroom {
  id                      Int                       @id @default(autoincrement())
  ownerId                 Int
  owner                   User                      @relation("OwnedClassrooms", fields: [ownerId], references: [id])
  name                    String
  checkinKey              String?                   @unique // 現場 QR 自助簽到金鑰（貼在教室看板）；可重新產生以作廢舊看板
  nextStudentNumber       Int                       @default(1) // 下一個要指派的學生編號（每教室各自從 1 開始，遞增不回收）
  nextCardSerial          Int                       @default(1) // 下一個要指派的課卡流水號（每教室各自從 1 開始；顯示格式見 src/lib/cardSerial.ts）
  // 軟刪除／封存。非 null = 教室已收掉：從切換選單消失、無法再切進去、
  // 成員的舊 JWT 也進不來（apiRoute 每次請求會重查 membership 並 join 這個條件）。
  // 資料完整保留以便救回；真正清資料留給日後的 purge script。
  deletedAt               DateTime?
  memberships             Membership[]
  cards                   Card[]
  students                Student[]
  lessons                 Lesson[]
  lessonGroups            LessonGroup[]
  inviteTokens            InviteToken[]
  tags                    Tag[]
  danceStyles             DanceStyle[]
  locations               Location[]
  // 在 LINE 官方帳號公開課表與價目表——沒綁定的人也看得到（src/service/lineBot.ts）。
  lineListed              Boolean                   @default(false)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  teachers                Teacher[]
  User                    User[]
  notificationPreferences NotificationPreference[]
  modules                 ClassroomModule[]
  skillCategories         SkillCategory[]
  skillTiers              SkillTier[]
  skills                  Skill[]
  financeSetting          FinanceSetting?
  financeSplitRules       FinanceSplitRule[]
  financeSettlements      FinanceLessonSettlement[]
  financeOpeningCustody   FinanceOpeningCustody[]
  financeRemittances      FinanceRemittance[]
  financeEntries          FinanceEntry[]
  financeSettingRevisions FinanceSettingRevision[]
  financeQuests           FinanceQuestDone[]
}

model Membership {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  classroomId Int
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  role        String    @default("owner")
  // 角色預設組合以外，多給／拿掉的權限（src/lib/permissions.ts）。只存差異，
  // 預設組合寫在程式碼裡，所以新增權限不用跑資料遷移。
  grants      String[]  @default([])
  revokes     String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Postgres does NOT index foreign keys automatically, and neither does
  // Prisma. Where a composite @@unique already leads with the FK column that
  // prefix serves single-column lookups, so no extra index is added — e.g.
  // `userId` here is covered by the unique below, `classroomId` is not.
  @@unique([userId, classroomId])
  @@index([classroomId])
}

/// 老師在教室裡做什麼：TEACHER 只教課、ASSISTANT 只當助教、BOTH 都會。
enum TeacherKind {
  TEACHER
  ASSISTANT
  BOTH
}

model Teacher {
  id                     Int                     @id @default(autoincrement())
  name                   String
  // Palette key (DANCE_STYLE_COLORS, src/lib/danceStyles.ts) for the avatar.
  color                  String                  @default("blue")
  note                   String?
  // Archived, not deleted, once a teacher has lessons — old lessons keep them.
  archivedAt             DateTime?
  classroomId            Int
  classroom              Classroom               @relation(fields: [classroomId], references: [id])
  lessons                LessonTeacher[]
  // The member (role teacher, or an admin) this teacher is. Their lessons show
  // under 我接下來的課 on the lessons page. One per user per classroom.
  userId                 Int?
  user                   User?                   @relation(fields: [userId], references: [id])
  // 老師／助教／都是：只當助教的，排課選老師時不列出；只教課的，點名選助教時不列出。
  kind                   TeacherKind             @default(TEACHER)
  assistedPeriods        LessonPeriodAssistant[]
  financeSplitShares     FinanceSplitShare[]
  financeVenueRules      FinanceSplitRule[]      @relation("FinanceVenueTeacher")
  financeSettlementLines FinanceSettlementLine[]
  invites                InviteToken[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([classroomId, userId])
  @@index([classroomId])
  @@index([userId])
}

model Card {
  id             Int           @id @default(autoincrement())
  name           String
  price          Int
  sessions       Int
  expiredAt      DateTime?
  classroomId    Int
  studentCards   StudentCard[]
  lessons        LessonCard[]
  isPracticeCard Boolean       @default(false)
  // Required on practice cards; null on general cards and on legacy practice
  // cards, which fall back to the lesson's style.
  danceStyleId   Int?
  danceStyle     DanceStyle?   @relation(fields: [danceStyleId], references: [id])
  // 體驗課卡：老師在課程頁的體驗名單登記時用，舊生（買過非體驗卡）預設 $0（src/lib/trialPrice.ts）。
  isTrial        Boolean       @default(false)
  classroom      Classroom     @relation(fields: [classroomId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([classroomId])
  @@index([danceStyleId])
}

model Student {
  id                  Int                         @id @default(autoincrement())
  number              Int // 教室內學生編號，從 1 開始、系統自動指派、不可編輯（見 src/service/student.ts）
  name                String
  avatarUrl           String
  note                String?
  randomKey           String?                     @unique // public-students share link token (NOT for LINE)
  lineBindKey         String?                     @unique // one-time key for the LINE binding deep link
  lineUserId          String? // bound LINE userId — NOT unique: one LINE account can bind multiple students across classrooms
  // 綁定的 LINE 顯示名稱（綁定時抓、學生開 LIFF 時更新），讓老師看得出有沒有綁錯人。
  lineDisplayName     String?
  classroomId         Int
  classroom           Classroom                   @relation(fields: [classroomId], references: [id])
  studentCards        StudentCard[]
  studentTags         StudentTag[]
  lessons             LessonStudent[]
  attendanceRecords   AttendanceRecord[]
  events              Event[]
  danceQualifications StudentDanceQualification[]
  renewalReminders    RenewalReminder[]
  // 封存（不是刪除）：名單、自助簽到、LIFF、續卡提醒都看不到；課卡、出席、收入照留，可還原。
  archivedAt          DateTime?
  // 合併學員時，被併掉（封存）的那筆指向保留的學員。純 Int、沒有 FK，只供追查。
  mergedIntoId        Int?
  // 老師最後一次複製 LINE 綁定邀請的時間（未綁定 LINE 清單用）。
  lineInviteSentAt    DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  // `classroomId` needs no index of its own — this unique leads with it.
  @@unique([classroomId, number])
  @@index([lineUserId])
}

model StudentDanceQualification {
  id           Int        @id @default(autoincrement())
  studentId    Int
  student      Student    @relation(fields: [studentId], references: [id])
  danceStyleId Int
  danceStyle   DanceStyle @relation(fields: [danceStyleId], references: [id])
  // Highest completed level (1 = 初階, 2 = 中階, 3 = 進階 — src/lib/danceLevels.ts).
  // Practice cards may be used in lessons whose level <= this.
  level        Int        @default(1)
  createdAt    DateTime   @default(now())

  @@unique([studentId, danceStyleId])
  @@index([danceStyleId])
}

model StudentCard {
  id                Int                @id @default(autoincrement())
  studentId         Int
  student           Student            @relation(fields: [studentId], references: [id])
  cardId            Int
  card              Card               @relation(fields: [cardId], references: [id])
  // 教室內課卡流水號，顯示成 #A0001（見 src/lib/cardSerial.ts）。沒有 DB unique：
  // StudentCard 沒有 classroomId，唯一性由 Classroom.nextCardSerial 的 row lock 保證。
  serialNumber      Int
  basePrice         Int
  finalPrice        Int
  totalSessions     Int
  remainingSessions Int
  purchaseSource    CardPurchaseSource @default(STAFF)
  purchasedByUserId Int?
  purchasedBy       User?              @relation("PurchasedStudentCards", fields: [purchasedByUserId], references: [id])
  isPaid            Boolean            @default(true) // existing rows treated as paid
  paidAt            DateTime?
  // 收款人：錢現在在誰手上（確認付款時可改選其他老師）。
  paidByUserId      Int?
  paidBy            User?              @relation("ConfirmedStudentCards", fields: [paidByUserId], references: [id])
  paymentMethod     PaymentMethod?
  paymentReference  String? // 轉帳末五碼，選填
  attendanceRecords AttendanceRecord[]
  note              String?
  origin            StudentCardOrigin  @default(PURCHASE)
  // 轉換鏈：欄位放在「舊卡」上指向新卡，所以多張舊卡可以合併成一張新卡
  // （複習卡 3 堂折 1 堂 Level 2 就是這個形狀）。
  convertedToId     Int?
  convertedTo       StudentCard?       @relation("StudentCardConversion", fields: [convertedToId], references: [id])
  convertedFrom     StudentCard[]      @relation("StudentCardConversion")
  // 轉讓：剩餘堂數整批給另一位學生。欄位放在「舊卡」上指向對方的新卡，一對一。
  transferredToId   Int?               @unique
  transferredTo     StudentCard?       @relation("StudentCardTransfer", fields: [transferredToId], references: [id])
  transferredFrom   StudentCard?       @relation("StudentCardTransfer")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  expiredAt         DateTime?

  @@index([convertedToId])
  @@index([serialNumber])
  // Composite, not a bare [studentId]: the hot query is "this student's cards
  // that aren't expired" (attendance card selection, renewal checks), and the
  // leading column still serves plain studentId lookups.
  @@index([studentId, expiredAt])
  @@index([cardId])
}

model Lesson {
  id                Int                @id @default(autoincrement())
  name              String
  classroomId       Int
  classroom         Classroom          @relation(fields: [classroomId], references: [id])
  status            String             @default("inProgress")
  endAt             DateTime?
  // "fixed" = a set run of dates, finished once every period is checked;
  // "ongoing" = keeps adding periods, never auto-finishes (src/lib/lessonKind.ts).
  kind              String             @default("fixed")
  // Set when a teacher ends a lesson by hand — finished regardless of kind.
  endedAt           DateTime?
  danceStyleId      Int
  danceStyle        DanceStyle         @relation(fields: [danceStyleId], references: [id])
  // Level taught (1 = 初階, 2 = 中階, 3 = 進階 — src/lib/danceLevels.ts).
  level             Int                @default(1)
  // 每次出席扣幾格課卡（外師課常用 2）。點名當下抄到 AttendanceRecord.sessionsUsed。
  sessionsPerAttendance Int            @default(1)
  // 單堂價（現場付費，不扣課卡）。null = 這堂不開放單堂付費。
  dropInPrice       Int?
  // 分部（台南／高雄…）。選填；課卡不分部限定。
  locationId        Int?
  location          Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  groupId           Int?
  group             LessonGroup?       @relation(fields: [groupId], references: [id])
  teachers          LessonTeacher[]
  cards             LessonCard[]
  periods           LessonPeriod[]
  students          LessonStudent[]
  financeSplitRules FinanceSplitRule[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([classroomId])
  @@index([groupId])
  @@index([danceStyleId])
  @@index([locationId])
}

// A dance style taught in one classroom (Bachata, Locking…). Classroom data,
// managed on /dance-styles. Never deleted, only archived, so
// old lessons and cards keep their style.
model DanceStyle {
  id              Int                         @id @default(autoincrement())
  classroomId     Int
  classroom       Classroom                   @relation(fields: [classroomId], references: [id])
  name            String
  // Palette key: green/orange/slate/stone/purple/blue/pink/teal/red/indigo.
  color           String
  // On: 初階/中階/進階 (src/lib/danceLevels.ts). Off: qualified or not — level is always 1.
  hasLevels       Boolean                     @default(false)
  sortOrder       Int                         @default(0)
  archivedAt      DateTime?
  lessons         Lesson[]
  cards           Card[]
  qualifications  StudentDanceQualification[]
  skillCategories SkillCategory[]
  skillTiers      SkillTier[]
  skills          Skill[]
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  // Leads with classroomId, so it also serves classroom lookups.
  @@unique([classroomId, name])
}

// 分部：同一間教室的不同上課地點（台南、高雄…）。Classroom data managed on
// /locations; archived, never deleted. Cards are NOT location-bound.
model Location {
  id                Int                @id @default(autoincrement())
  classroomId       Int
  classroom         Classroom          @relation(fields: [classroomId], references: [id])
  name              String
  address           String?
  sortOrder         Int                @default(0)
  archivedAt        DateTime?
  lessons           Lesson[]
  financeSplitRules FinanceSplitRule[]
  financeEntries    FinanceEntry[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Leads with classroomId, so it also serves classroom lookups.
  @@unique([classroomId, name])
}

// Bundles recurring lesson slots that share a schedule (e.g. "週日課" holding
// several time slots taught on Sundays) so they can be browsed as one unit.
// `groupId` on Lesson is nullable — ungrouped lessons are treated as a
// virtual "未分類" bucket, no row needed here for that.
model LessonGroup {
  id          Int       @id @default(autoincrement())
  name        String
  classroomId Int
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  lessons     Lesson[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // The unique leads with `name`, so it does NOT serve classroomId lookups.
  @@unique([name, classroomId])
  @@index([classroomId])
}

model LessonTeacher {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  teacherId Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, teacherId])
  @@index([teacherId])
}

model LessonCard {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  cardId    Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  card      Card     @relation(fields: [cardId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, cardId])
  @@index([cardId])
}

model LessonPeriod {
  id                Int                      @id @default(autoincrement())
  lessonId          Int
  lesson            Lesson                   @relation(fields: [lessonId], references: [id])
  attendanceRecords AttendanceRecord[]
  assistants        LessonPeriodAssistant[]
  financeSettlement FinanceLessonSettlement?
  startTime         DateTime
  endTime           DateTime
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  attendanceTakenAt DateTime?

  // Daily revenue and the calendar both filter a lesson's periods by date.
  @@index([lessonId, startTime])
}

// 這一堂誰來當助教（點名頁「今天的助教」）。不開水庫也記；水庫照分帳規則算助教費。
model LessonPeriodAssistant {
  id             Int          @id @default(autoincrement())
  lessonPeriodId Int
  lessonPeriod   LessonPeriod @relation(fields: [lessonPeriodId], references: [id], onDelete: Cascade)
  teacherId      Int
  teacher        Teacher      @relation(fields: [teacherId], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([lessonPeriodId, teacherId])
  @@index([teacherId])
}

model LessonStudent {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  studentId Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, studentId])
  @@index([studentId])
}

model AttendanceRecord {
  id             Int              @id @default(autoincrement())
  lessonPeriodId Int
  lessonPeriod   LessonPeriod     @relation(fields: [lessonPeriodId], references: [id])
  studentId      Int
  student        Student          @relation(fields: [studentId], references: [id])
  studentCardId  Int?
  studentCard    StudentCard?     @relation(fields: [studentCardId], references: [id])
  source         AttendanceSource @default(TEACHER)
  // 這筆出席從 studentCard 扣了幾格（扣卡當下抄自 Lesson.sessionsPerAttendance；
  // 沒綁卡時是將來綁卡要扣的格數）。退卡退同樣格數、收入照它認列。
  sessionsUsed   Int              @default(1)
  // 這次付單堂（不扣卡）。有它就不算「出席沒綁課卡」。
  dropInCharge   DropInCharge?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // One attendance record per student per period — guards against duplicate
  // self check-ins (LIFF double-tap / concurrent submit) double-charging a card.
  @@unique([lessonPeriodId, studentId])
  @@index([studentId])
  @@index([studentCardId])
}

model InviteToken {
  id          Int       @id @default(autoincrement())
  token       String    @unique
  classroomId Int
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  maxUses     Int
  uses        Int       @default(0)
  // Role the joiner gets ("admin" | "teacher" | "assistant", src/lib/roles.ts),
  // and for a teacher the Teacher row they're linked to on joining.
  role        String    @default("assistant")
  teacherId   Int?
  teacher     Teacher?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([classroomId])
  @@index([teacherId])
}

model Event {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  studentId    Int
  student      Student  @relation(fields: [studentId], references: [id])
  resourceType String
  resourceId   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // The timeline reads one student's events newest-first, so the sort column
  // rides along in the index.
  @@index([studentId, createdAt])
}

model Tag {
  id          Int          @id @default(autoincrement())
  name        String
  classroomId Int
  classroom   Classroom    @relation(fields: [classroomId], references: [id])
  studentTags StudentTag[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // The unique leads with `name`, so it does NOT serve classroomId lookups.
  @@unique([name, classroomId])
  @@index([classroomId])
}

model StudentTag {
  id        Int      @id @default(autoincrement())
  studentId Int
  tagId     Int
  student   Student  @relation(fields: [studentId], references: [id])
  tag       Tag      @relation(fields: [tagId], references: [id])
  createdAt DateTime @default(now())

  @@unique([studentId, tagId])
  @@index([tagId])
}

// Per-LINE-account UI state. A LINE userId can be both a teacher (User) and a
// student (Student) — this remembers which menu to show by default so switching
// to the student menu sticks across messages.
model LineAccount {
  lineUserId        String       @id
  menuMode          LineMenuMode @default(TEACHER)
  // The student the account last selected in LIFF, so the LINE bot's menu shows
  // the same one. Plain id (no FK) — webhook re-validates ownership before use.
  selectedStudentId Int?
  // 沒綁定的人在 LINE 選過要看哪間公開教室的課表／價目（多間教室共用官方帳號時）。
  // Plain id (no FK) — lineBot re-checks it's still listed before use.
  browseClassroomId Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

// 續卡提醒的推播紀錄。刻意獨立於 `Event`——`GET /api/students/[id]/events` 會把
// 所有 event 畫在學生頁時間軸上，推播紀錄放進去會污染 UI。這張表只服務冷卻判定。
model RenewalReminder {
  id            Int      @id @default(autoincrement())
  studentId     Int
  student       Student  @relation(fields: [studentId], references: [id])
  // 觸發這次推播的那張用完的卡，僅供追查；卡之後被轉換／過期也不影響冷卻判定。
  studentCardId Int?
  sentAt        DateTime @default(now())

  // 冷卻查的是「這位學生最近一次推播是什麼時候」，排序欄位跟著進索引，
  // 和 Event 的 [studentId, createdAt] 同一個道理。
  @@index([studentId, sentAt])
}

// App（mobile/）註冊的 Expo push token。token 是裝置層級的：同一支手機換帳號登入時，
// 這列改掛到新的 user 身上，不會兩個帳號收到同一支手機的通知。
model PushToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  platform  String // "ios" | "android"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // App 每次啟動都會重新註冊，等於「最後一次看到」

  @@index([userId])
}

// 瀏覽器的 Web Push 訂閱（網頁版推播；App 走上面的 PushToken）。一個瀏覽器一列，
// endpoint 是瀏覽器推播服務給的網址，p256dh/auth 是加密用的金鑰，見 src/lib/webPush.ts。
model WebPushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// 老師對某間教室某類推播的開關。沒有這列 = 預設開啟，所以只存「關掉」或改過的。
model NotificationPreference {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  classroomId Int
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  type        TodoType
  enabled     Boolean
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, classroomId, type])
  @@index([classroomId])
}

// 教室開了哪些功能模組（src/lib/permissions.ts 的 MODULES）。關閉＝刪掉這一列，
// 模組自己的資料表不動，重新開啟資料就回來。見 docs/modules-plan.md。
model ClassroomModule {
  id          Int       @id @default(autoincrement())
  classroomId Int
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  module      String
  enabledAt   DateTime  @default(now())
  enabledById Int?
  enabledBy   User?     @relation(fields: [enabledById], references: [id])

  @@unique([classroomId, module])
}

// ===== 模組：技能樹（docs/modules-plan.md 第 2 階段）=====
// 一個舞種一棵樹：分類（tab）× 等級（欄）× 技能。「這個舞種有樹」＝至少有一個分類。

// 分類（teach-what: treeSchools）。color 是 DANCE_STYLE_COLORS 之一，icon 是 SKILL_CATEGORY_ICONS 之一
// （src/domains/curriculum/skillTree.ts）。刪除前由 service 先把技能搬走或封存。
model SkillCategory {
  id           Int        @id @default(autoincrement())
  classroomId  Int
  classroom    Classroom  @relation(fields: [classroomId], references: [id])
  danceStyleId Int
  danceStyle   DanceStyle @relation(fields: [danceStyleId], references: [id])
  name         String
  color        String
  icon         String
  sortOrder    Int        @default(0)
  skills       Skill[]
  createdAt    DateTime   @default(now())

  @@index([classroomId, danceStyleId])
  @@index([danceStyleId])
}

// 等級欄（teach-what: treeTiers）。顯示名「一轉、二轉…」由位置決定，label 是自由標籤（例如 Lv1）。
model SkillTier {
  id           Int        @id @default(autoincrement())
  classroomId  Int
  classroom    Classroom  @relation(fields: [classroomId], references: [id])
  danceStyleId Int
  danceStyle   DanceStyle @relation(fields: [danceStyleId], references: [id])
  label        String     @default("")
  sortOrder    Int        @default(0)
  skills       Skill[]
  createdAt    DateTime   @default(now())

  @@index([classroomId, danceStyleId])
  @@index([danceStyleId])
}

// 技能。categoryId 是 null ＝ 在待定區；放進樹只是填上分類與等級，留言、已讀都不用搬。
// 樹上的技能只封存（archivedAt），待定的可以真的刪除（留言等一起 cascade）。
model Skill {
  id           Int             @id @default(autoincrement())
  classroomId  Int
  classroom    Classroom       @relation(fields: [classroomId], references: [id])
  danceStyleId Int
  danceStyle   DanceStyle      @relation(fields: [danceStyleId], references: [id])
  categoryId   Int?
  category     SkillCategory?  @relation(fields: [categoryId], references: [id])
  // 待定的可以沒有等級；放進樹時必填（service 檢查）
  tierId       Int?
  tier         SkillTier?      @relation(fields: [tierId], references: [id])
  name         String
  fullName     String          @default("")
  description  String          @default("")
  sortOrder    Int             @default(0)
  createdById  Int?
  createdBy    User?           @relation(fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
  archivedAt   DateTime?
  changes      SkillChange[]
  comments     SkillComment[]
  reads        SkillTalkRead[]

  @@index([classroomId, danceStyleId])
  @@index([danceStyleId])
  @@index([categoryId])
  @@index([tierId])
}

// 修改紀錄（teach-what: treeSkillChanges）。from/to 存人看得懂的字（分類名、「二轉」）。
// kind: add | place | rename | describe | move_tier | move_category | archive | restore
model SkillChange {
  id        Int      @id @default(autoincrement())
  skillId   Int
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillName String
  kind      String
  fromValue String?
  toValue   String?
  actorId   Int?
  actor     User?    @relation(fields: [actorId], references: [id])
  createdAt DateTime @default(now())

  @@index([skillId, createdAt])
}

// 技能討論。回覆只有一層（回覆的回覆會被攤平到同一串）；每個技能最多一則結論。
// 不放 classroomId：一律經由 skill.classroomId 驗證。
model SkillComment {
  id             Int                    @id @default(autoincrement())
  skillId        Int
  skill          Skill                  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  parentId       Int?
  parent         SkillComment?          @relation("SkillCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        SkillComment[]         @relation("SkillCommentReplies")
  authorId       Int?
  author         User?                  @relation("SkillCommentAuthor", fields: [authorId], references: [id])
  text           String
  conclusionAt   DateTime?
  conclusionById Int?
  conclusionBy   User?                  @relation("SkillCommentConclusion", fields: [conclusionById], references: [id])
  createdAt      DateTime               @default(now())
  editedAt       DateTime?
  reactions      SkillCommentReaction[]
  mentions       SkillCommentMention[]

  @@index([skillId])
  @@index([parentId])
}

// 表情：一人一則一個，換表情＝覆蓋。kind: like | love | haha | wow | think | down
model SkillCommentReaction {
  commentId Int
  comment   SkillComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  kind      String
  createdAt DateTime     @default(now())

  @@id([commentId, userId])
  @@index([userId])
}

// 被 @ 到。seenAt 是 null ＝ 還沒打開那串討論。
model SkillCommentMention {
  commentId Int
  comment   SkillComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  seenAt    DateTime?

  @@id([commentId, userId])
  @@index([userId])
}

// 每個人最後一次打開某技能討論的時間。
model SkillTalkRead {
  userId  Int
  user    User     @relation(fields: [userId], references: [id])
  skillId Int
  skill   Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  readAt  DateTime @default(now())

  @@id([userId, skillId])
  @@index([skillId])
}

// ---------- 模組：水庫（docs/finance-plan.md 第一步：代收＋繳回＋大水庫收支） ----------
// 課卡收款不另存：直接讀 StudentCard（paidByUserId、paidAt、finalPrice，origin = PURCHASE、paidAt ≥ 啟用日）。

// 一間教室一筆。setupCompletedAt 為 null ＝ 還沒建城。
model FinanceSetting {
  classroomId        Int       @id
  classroom          Classroom @relation(fields: [classroomId], references: [id])
  // 營收負責人（老闆）：確認繳回、記大水庫支出的人，推播也發給他。
  revenueOwnerUserId Int?
  revenueOwner       User?     @relation("FinanceRevenueOwner", fields: [revenueOwnerUserId], references: [id])
  // 啟用日（台北時間當天 00:00）。這天之前付款的課卡不算代收。
  startDate          DateTime?
  // 啟用日當天大水庫的錢（現金＋銀行一個數）
  openingBalance     Int       @default(0)
  // 啟用日之前老闆放進來的錢（欠老闆的）。null ＝ 建城時略過，不顯示建城貸款。
  openingOwnerLoan   Int?
  // 手上的錢超過幾天沒繳回就標紅
  overdueDays        Int       @default(7)
  // 每月幾號發薪（第三步月結用）
  payday             Int       @default(5)
  setupCompletedAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([revenueOwnerUserId])
}

// 期初代收：啟用日那天，某人手上還沒交的課卡錢。
model FinanceOpeningCustody {
  id          Int       @id @default(autoincrement())
  classroomId Int
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  amount      Int

  @@unique([classroomId, userId])
  @@index([userId])
}

enum FinanceRemittanceStatus {
  PENDING // 轉交中，等營收負責人確認
  CONFIRMED // 收到了
  REJECTED // 金額不對，退回（送的人可以改了再送）
  WITHDRAWN // 送的人撤回
}

// 繳回：代收人把錢交進大水庫。
model FinanceRemittance {
  id           Int                     @id @default(autoincrement())
  classroomId  Int
  classroom    Classroom               @relation(fields: [classroomId], references: [id])
  fromUserId   Int
  fromUser     User                    @relation("FinanceRemittanceFrom", fields: [fromUserId], references: [id])
  amount       Int
  method       PaymentMethod
  reference    String? // 轉帳末五碼
  sentOn       DateTime // 交錢的日子（台北時間當天 00:00）
  note         String?
  status       FinanceRemittanceStatus @default(PENDING)
  reviewedById Int?
  reviewedBy   User?                   @relation("FinanceRemittanceReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  rejectReason String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([classroomId, status])
  @@index([fromUserId])
  @@index([reviewedById])
}

// 大水庫手記帳。金額一律是正數，進或出看分類（src/domains/finance/entries.ts）。
model FinanceEntry {
  id          Int                    @id @default(autoincrement())
  classroomId Int
  classroom   Classroom              @relation(fields: [classroomId], references: [id])
  date        DateTime // 台北時間當天 00:00
  category    String
  amount      Int
  payeeUserId Int?
  payeeUser   User?                  @relation("FinanceEntryPayee", fields: [payeeUserId], references: [id])
  payeeName   String? // 付給不是成員的人（例如 24steps）
  // 場租掛分部：場租帳＝這個分部的場租支出 − 這個分部已經算掉的場地費（docs/finance-db.md §4.3）
  locationId  Int?
  location    Location?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  description String?
  createdById Int
  createdBy   User                   @relation("FinanceEntryCreator", fields: [createdById], references: [id])
  // 作廢（不真的刪除），作廢也寫一筆修改紀錄。
  voidedAt    DateTime?
  revisions   FinanceEntryRevision[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([classroomId, date])
  @@index([payeeUserId])
  @@index([createdById])
}

model FinanceEntryRevision {
  id         Int          @id @default(autoincrement())
  entryId    Int
  entry      FinanceEntry @relation(fields: [entryId], references: [id])
  editedById Int
  editedBy   User         @relation(fields: [editedById], references: [id])
  reason     String
  before     Json
  after      Json? // null ＝ 作廢
  createdAt  DateTime     @default(now())

  @@index([entryId])
  @@index([editedById])
}

// 建城之後改期初數字、換營收負責人的紀錄。
model FinanceSettingRevision {
  id          Int       @id @default(autoincrement())
  classroomId Int
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  editedById  Int
  editedBy    User      @relation(fields: [editedById], references: [id])
  reason      String
  before      Json
  after       Json
  createdAt   DateTime  @default(now())

  @@index([classroomId])
  @@index([editedById])
}

// 新手任務裡，資料推不出來的那幾項（試玩推車、看過背包、通知過大家）。
model FinanceQuestDone {
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  classroomId Int
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  quest       String
  completedAt DateTime  @default(now())

  @@id([userId, classroomId, quest])
  @@index([classroomId])
}

// ===== 水庫第二步：分帳規則、每堂驗收（docs/finance-db.md §4）=====

enum FinanceRuleScope {
  CLASSROOM
  LOCATION
  LESSON
}

enum FinanceTeacherPay {
  NONE // 不用算：收入全部留在教室
  HOURLY // 鐘點費：老師每堂拿固定的錢
  SPLIT // 拆帳：扣掉場地費、助教費、抽成，剩下的給老師
}

enum FinanceFeeMode {
  NONE
  PER_LESSON
  PER_DAY // 當天的課平攤，早的堂多 1 元
}

enum FinanceVenuePayee {
  MEMBER // 付給成員（老師資料）→ 進他的薪資單
  EXTERNAL // 付給外面的場地 → 場租帳
}

enum FinanceRemainderTo {
  REVENUE_OWNER
  FUND
}

// 一列＝某一層在 effectiveFrom（月初）之後的設定；改規則＝新增一列。設定欄位 null ＝ 沿用上一層。
model FinanceSplitRule {
  id              Int                 @id @default(autoincrement())
  classroomId     Int
  classroom       Classroom           @relation(fields: [classroomId], references: [id])
  scope           FinanceRuleScope
  locationId      Int?
  location        Location?           @relation(fields: [locationId], references: [id])
  lessonId        Int?
  lesson          Lesson?             @relation(fields: [lessonId], references: [id])
  effectiveFrom   DateTime
  teacherPay      FinanceTeacherPay?
  hourlyFee       Int?
  venueMode       FinanceFeeMode?
  venueAmount     Int?
  venuePayee      FinanceVenuePayee?
  venueTeacherId  Int?
  venueTeacher    Teacher?            @relation("FinanceVenueTeacher", fields: [venueTeacherId], references: [id])
  assistantMode   FinanceFeeMode?
  assistantAmount Int?
  commissionPct   Int?
  // 只在 LESSON 層：整門課手動結算
  manual          Boolean?
  // 只在 CLASSROOM 層
  roundTo         Int?
  remainderTo     FinanceRemainderTo?
  shares          FinanceSplitShare[]
  reason          String?
  createdById     Int
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([classroomId, scope, effectiveFrom])
  @@index([locationId])
  @@index([lessonId])
  @@index([venueTeacherId])
}

// 只在 LESSON 層：多位老師的比例（加起來 100）；沒有＝平分。
model FinanceSplitShare {
  id        Int              @id @default(autoincrement())
  ruleId    Int
  rule      FinanceSplitRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  teacherId Int
  teacher   Teacher          @relation(fields: [teacherId], references: [id])
  pct       Int

  @@unique([ruleId, teacherId])
  @@index([teacherId])
}

// 每堂驗收：按驗收那一刻存下算出來的結果。驗收前全部即時算，不存。
model FinanceLessonSettlement {
  id             Int                         @id @default(autoincrement())
  classroomId    Int
  classroom      Classroom                   @relation(fields: [classroomId], references: [id])
  lessonPeriodId Int                         @unique
  lessonPeriod   LessonPeriod                @relation(fields: [lessonPeriodId], references: [id])
  // 算這堂用到的輸入（收入、人數、老師、助教、規則版本）。跟現在重算的不一樣＝點名改過，退回待驗收。
  inputsKey      String
  ruleIds        Int[]
  revenue        Int
  estimated      Int                         @default(0)
  attendeeCount  Int
  venueFee       Int
  assistantFee   Int
  commission     Int
  remainder      Int
  // 這堂留在教室的錢（抽成，加上零頭歸基金、鐘點費制的餘額；可能是負的）
  fund           Int
  overridden     Boolean                     @default(false)
  overrideReason String?
  lines          FinanceSettlementLine[]
  revisions      FinanceSettlementRevision[]
  verifiedById   Int
  verifiedBy     User                        @relation("FinanceSettlementVerifier", fields: [verifiedById], references: [id])
  verifiedAt     DateTime
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([classroomId, verifiedAt])
  @@index([verifiedById])
}

enum FinanceLineKind {
  TEACHER
  VENUE
  ASSISTANT
  REMAINDER
}

model FinanceSettlementLine {
  id           Int                     @id @default(autoincrement())
  settlementId Int
  settlement   FinanceLessonSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  kind         FinanceLineKind
  // VENUE 付給外面的場地時是 null
  teacherId    Int?
  teacher      Teacher?                @relation(fields: [teacherId], references: [id])
  amount       Int

  @@index([settlementId])
  @@index([teacherId])
}

// 重新驗收、改數字的紀錄。
model FinanceSettlementRevision {
  id           Int                     @id @default(autoincrement())
  settlementId Int
  settlement   FinanceLessonSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  editedById   Int
  reason       String
  before       Json
  after        Json
  createdAt    DateTime                @default(now())

  @@index([settlementId])
}

// 一筆出席改付單堂費（Lesson.dropInPrice），不扣課卡。跟著出席紀錄走：
// 取消點名、重設時段刪掉出席紀錄時一起刪。收款欄位同 StudentCard。
model DropInCharge {
  id                 Int              @id @default(autoincrement())
  attendanceRecordId Int              @unique
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  amount             Int
  isPaid             Boolean          @default(false)
  paidAt             DateTime?
  paymentMethod      PaymentMethod?
  paymentReference   String?
  // 收款人：錢在誰手上。
  paidByUserId       Int?
  paidBy             User?            @relation("ConfirmedDropIns", fields: [paidByUserId], references: [id])
  createdAt          DateTime         @default(now())
}
