// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CardPurchaseSource {
  STAFF // bought by 老闆/助教 (a User) on the backend
  STUDENT // self-purchased by the student (future flow; purchasedByUserId is null)
}

enum StudentCardOrigin {
  PURCHASE // 正常購買 — 有真的金流，計入課卡營收
  CONVERSION // 由舊卡轉換而來（例：Level 1 升級 Level 2、複習卡折抵）— 不重複計入課卡營收
}

enum AttendanceSource {
  TEACHER // recorded by a teacher/助教 on the backend
  STUDENT // self check-in by the student via LIFF
}

// 「待處理」的三類事項，也是老師端推播的種類（見 src/service/todos.ts、src/service/push.ts）。
enum TodoType {
  UNPAID_CARD // 學生自助買卡，待確認收款
  NEEDS_RENEWAL // 學生被加上「Needs Renewal」tag
  UNBOUND_ATTENDANCE // 出席紀錄沒有綁課卡
}

// 收款方式（確認付款時記錄；見 confirm-payment route）。
enum PaymentMethod {
  CASH
  TRANSFER
}

enum LineMenuMode {
  TEACHER
  STUDENT
}

model User {
  id                      Int                      @id @default(autoincrement())
  email                   String                   @unique
  name                    String
  password                String
  randomKey               String?                  @unique // one-time key shown on the website; sent to the LINE bot to bind
  lineUserId              String?                  @unique // bound LINE userId; used for LIFF auto-login
  googleSub               String?                  @unique // Google 帳號的 sub（Google 登入）
  appleSub                String?                  @unique // Apple 帳號的 sub（Sign in with Apple）
  // 刪帳號時要拿它向 Apple 撤銷授權（App Store 5.1.1(v)）。秘密：永遠不要放進 API 回應
  appleRefreshToken       String?
  appleClientId           String? // 拿到 refresh token 的 client（App 的 bundle ID 或網頁的 Services ID）
  classrooms              Classroom[]              @relation("OwnedClassrooms")
  memberships             Membership[]
  purchasedStudentCards   StudentCard[]            @relation("PurchasedStudentCards")
  confirmedStudentCards   StudentCard[]            @relation("ConfirmedStudentCards")
  currentClassroomId      Int?
  currentClassroom        Classroom?               @relation(fields: [currentClassroomId], references: [id])
  // 帳號已刪除（匿名化）。非 null = decodeAuthToken 把這個人當成沒登入，
  // 其他裝置上還沒過期的 JWT 也就跟著失效（見 DELETE /api/me）。
  deletedAt               DateTime?
  pushTokens              PushToken[]
  webPushSubscriptions    WebPushSubscription[]
  notificationPreferences NotificationPreference[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model Classroom {
  id                      Int                      @id @default(autoincrement())
  ownerId                 Int
  owner                   User                     @relation("OwnedClassrooms", fields: [ownerId], references: [id])
  name                    String
  checkinKey              String?                  @unique // 現場 QR 自助簽到金鑰（貼在教室看板）；可重新產生以作廢舊看板
  nextStudentNumber       Int                      @default(1) // 下一個要指派的學生編號（每教室各自從 1 開始，遞增不回收）
  nextCardSerial          Int                      @default(1) // 下一個要指派的課卡流水號（每教室各自從 1 開始；顯示格式見 src/lib/cardSerial.ts）
  // 軟刪除／封存。非 null = 教室已收掉：從切換選單消失、無法再切進去、
  // 成員的舊 JWT 也進不來（apiRoute 每次請求會重查 membership 並 join 這個條件）。
  // 資料完整保留以便救回；真正清資料留給日後的 purge script。
  deletedAt               DateTime?
  memberships             Membership[]
  cards                   Card[]
  students                Student[]
  lessons                 Lesson[]
  lessonGroups            LessonGroup[]
  inviteTokens            InviteToken[]
  tags                    Tag[]
  danceStyles             DanceStyle[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  teachers                Teacher[]
  User                    User[]
  notificationPreferences NotificationPreference[]
}

model Membership {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  classroomId Int
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  role        String    @default("owner")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Postgres does NOT index foreign keys automatically, and neither does
  // Prisma. Where a composite @@unique already leads with the FK column that
  // prefix serves single-column lookups, so no extra index is added — e.g.
  // `userId` here is covered by the unique below, `classroomId` is not.
  @@unique([userId, classroomId])
  @@index([classroomId])
}

model Teacher {
  id          Int             @id @default(autoincrement())
  name        String
  // Palette key (DANCE_STYLE_COLORS, src/lib/danceStyles.ts) for the avatar.
  color       String          @default("blue")
  note        String?
  // Archived, not deleted, once a teacher has lessons — old lessons keep them.
  archivedAt  DateTime?
  classroomId Int
  classroom   Classroom       @relation(fields: [classroomId], references: [id])
  lessons     LessonTeacher[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([classroomId])
}

model Card {
  id             Int           @id @default(autoincrement())
  name           String
  price          Int
  sessions       Int
  expiredAt      DateTime?
  classroomId    Int
  studentCards   StudentCard[]
  lessons        LessonCard[]
  isPracticeCard Boolean       @default(false)
  // Required on practice cards; null on general cards and on legacy practice
  // cards, which fall back to the lesson's style.
  danceStyleId   Int?
  danceStyle     DanceStyle?   @relation(fields: [danceStyleId], references: [id])
  // 體驗課卡：自助點名時新同學照價、舊生（買過非體驗卡）預設 $0（src/service/trial.ts）。
  isTrial        Boolean       @default(false)
  classroom      Classroom     @relation(fields: [classroomId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([classroomId])
  @@index([danceStyleId])
}

model Student {
  id                  Int                         @id @default(autoincrement())
  number              Int // 教室內學生編號，從 1 開始、系統自動指派、不可編輯（見 src/service/student.ts）
  name                String
  avatarUrl           String
  note                String?
  randomKey           String?                     @unique // public-students share link token (NOT for LINE)
  lineBindKey         String?                     @unique // one-time key for the LINE binding deep link
  lineUserId          String? // bound LINE userId — NOT unique: one LINE account can bind multiple students across classrooms
  classroomId         Int
  classroom           Classroom                   @relation(fields: [classroomId], references: [id])
  studentCards        StudentCard[]
  studentTags         StudentTag[]
  lessons             LessonStudent[]
  attendanceRecords   AttendanceRecord[]
  events              Event[]
  danceQualifications StudentDanceQualification[]
  renewalReminders    RenewalReminder[]
  // 封存（不是刪除）：名單、自助簽到、LIFF、續卡提醒都看不到；課卡、出席、收入照留，可還原。
  archivedAt          DateTime?
  // 合併學員時，被併掉（封存）的那筆指向保留的學員。純 Int、沒有 FK，只供追查。
  mergedIntoId        Int?
  // 老師最後一次複製 LINE 綁定邀請的時間（未綁定 LINE 清單用）。
  lineInviteSentAt    DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  // `classroomId` needs no index of its own — this unique leads with it.
  @@unique([classroomId, number])
  @@index([lineUserId])
}

model StudentDanceQualification {
  id           Int        @id @default(autoincrement())
  studentId    Int
  student      Student    @relation(fields: [studentId], references: [id])
  danceStyleId Int
  danceStyle   DanceStyle @relation(fields: [danceStyleId], references: [id])
  // Highest completed level (1 = 初階, 2 = 中階, 3 = 進階 — src/lib/danceLevels.ts).
  // Practice cards may be used in lessons whose level <= this.
  level        Int        @default(1)
  createdAt    DateTime   @default(now())

  @@unique([studentId, danceStyleId])
  @@index([danceStyleId])
}

model StudentCard {
  id                Int                @id @default(autoincrement())
  studentId         Int
  student           Student            @relation(fields: [studentId], references: [id])
  cardId            Int
  card              Card               @relation(fields: [cardId], references: [id])
  // 教室內課卡流水號，顯示成 #A0001（見 src/lib/cardSerial.ts）。沒有 DB unique：
  // StudentCard 沒有 classroomId，唯一性由 Classroom.nextCardSerial 的 row lock 保證。
  serialNumber      Int
  basePrice         Int
  finalPrice        Int
  totalSessions     Int
  remainingSessions Int
  purchaseSource    CardPurchaseSource @default(STAFF)
  purchasedByUserId Int?
  purchasedBy       User?              @relation("PurchasedStudentCards", fields: [purchasedByUserId], references: [id])
  isPaid            Boolean            @default(true) // existing rows treated as paid
  paidAt            DateTime?
  // 收款人：錢現在在誰手上（確認付款時可改選其他老師）。
  paidByUserId      Int?
  paidBy            User?              @relation("ConfirmedStudentCards", fields: [paidByUserId], references: [id])
  paymentMethod     PaymentMethod?
  paymentReference  String? // 轉帳末五碼，選填
  attendanceRecords AttendanceRecord[]
  note              String?
  origin            StudentCardOrigin  @default(PURCHASE)
  // 轉換鏈：欄位放在「舊卡」上指向新卡，所以多張舊卡可以合併成一張新卡
  // （複習卡 3 堂折 1 堂 Level 2 就是這個形狀）。
  convertedToId     Int?
  convertedTo       StudentCard?       @relation("StudentCardConversion", fields: [convertedToId], references: [id])
  convertedFrom     StudentCard[]      @relation("StudentCardConversion")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  expiredAt         DateTime?

  @@index([convertedToId])
  @@index([serialNumber])
  // Composite, not a bare [studentId]: the hot query is "this student's cards
  // that aren't expired" (attendance card selection, renewal checks), and the
  // leading column still serves plain studentId lookups.
  @@index([studentId, expiredAt])
  @@index([cardId])
}

model Lesson {
  id           Int             @id @default(autoincrement())
  name         String
  classroomId  Int
  classroom    Classroom       @relation(fields: [classroomId], references: [id])
  status       String          @default("inProgress")
  endAt        DateTime?
  // "fixed" = a set run of dates, finished once every period is checked;
  // "ongoing" = keeps adding periods, never auto-finishes (src/lib/lessonKind.ts).
  kind         String          @default("fixed")
  // Set when a teacher ends a lesson by hand — finished regardless of kind.
  endedAt      DateTime?
  danceStyleId Int
  danceStyle   DanceStyle      @relation(fields: [danceStyleId], references: [id])
  // Level taught (1 = 初階, 2 = 中階, 3 = 進階 — src/lib/danceLevels.ts).
  level        Int             @default(1)
  groupId      Int?
  group        LessonGroup?    @relation(fields: [groupId], references: [id])
  teachers     LessonTeacher[]
  cards        LessonCard[]
  periods      LessonPeriod[]
  students     LessonStudent[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([classroomId])
  @@index([groupId])
  @@index([danceStyleId])
}

// A dance style taught in one classroom (Bachata, Locking…). Classroom data,
// managed on /dance-styles. Never deleted, only archived, so
// old lessons and cards keep their style.
model DanceStyle {
  id             Int                         @id @default(autoincrement())
  classroomId    Int
  classroom      Classroom                   @relation(fields: [classroomId], references: [id])
  name           String
  // Palette key: green/orange/slate/stone/purple/blue/pink/teal/red/indigo.
  color          String
  // On: 初階/中階/進階 (src/lib/danceLevels.ts). Off: qualified or not — level is always 1.
  hasLevels      Boolean                     @default(false)
  sortOrder      Int                         @default(0)
  archivedAt     DateTime?
  lessons        Lesson[]
  cards          Card[]
  qualifications StudentDanceQualification[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  // Leads with classroomId, so it also serves classroom lookups.
  @@unique([classroomId, name])
}

// Bundles recurring lesson slots that share a schedule (e.g. "週日課" holding
// several time slots taught on Sundays) so they can be browsed as one unit.
// `groupId` on Lesson is nullable — ungrouped lessons are treated as a
// virtual "未分類" bucket, no row needed here for that.
model LessonGroup {
  id          Int       @id @default(autoincrement())
  name        String
  classroomId Int
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  lessons     Lesson[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // The unique leads with `name`, so it does NOT serve classroomId lookups.
  @@unique([name, classroomId])
  @@index([classroomId])
}

model LessonTeacher {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  teacherId Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, teacherId])
  @@index([teacherId])
}

model LessonCard {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  cardId    Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  card      Card     @relation(fields: [cardId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, cardId])
  @@index([cardId])
}

model LessonPeriod {
  id                Int                @id @default(autoincrement())
  lessonId          Int
  lesson            Lesson             @relation(fields: [lessonId], references: [id])
  attendanceRecords AttendanceRecord[]
  startTime         DateTime
  endTime           DateTime
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  attendanceTakenAt DateTime?

  // Daily revenue and the calendar both filter a lesson's periods by date.
  @@index([lessonId, startTime])
}

model LessonStudent {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  studentId Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, studentId])
  @@index([studentId])
}

model AttendanceRecord {
  id             Int              @id @default(autoincrement())
  lessonPeriodId Int
  lessonPeriod   LessonPeriod     @relation(fields: [lessonPeriodId], references: [id])
  studentId      Int
  student        Student          @relation(fields: [studentId], references: [id])
  studentCardId  Int?
  studentCard    StudentCard?     @relation(fields: [studentCardId], references: [id])
  source         AttendanceSource @default(TEACHER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // One attendance record per student per period — guards against duplicate
  // self check-ins (LIFF double-tap / concurrent submit) double-charging a card.
  @@unique([lessonPeriodId, studentId])
  @@index([studentId])
  @@index([studentCardId])
}

model InviteToken {
  id          Int       @id @default(autoincrement())
  token       String    @unique
  classroomId Int
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  maxUses     Int
  uses        Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([classroomId])
}

model Event {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  studentId    Int
  student      Student  @relation(fields: [studentId], references: [id])
  resourceType String
  resourceId   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // The timeline reads one student's events newest-first, so the sort column
  // rides along in the index.
  @@index([studentId, createdAt])
}

model Tag {
  id          Int          @id @default(autoincrement())
  name        String
  classroomId Int
  classroom   Classroom    @relation(fields: [classroomId], references: [id])
  studentTags StudentTag[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // The unique leads with `name`, so it does NOT serve classroomId lookups.
  @@unique([name, classroomId])
  @@index([classroomId])
}

model StudentTag {
  id        Int      @id @default(autoincrement())
  studentId Int
  tagId     Int
  student   Student  @relation(fields: [studentId], references: [id])
  tag       Tag      @relation(fields: [tagId], references: [id])
  createdAt DateTime @default(now())

  @@unique([studentId, tagId])
  @@index([tagId])
}

// Per-LINE-account UI state. A LINE userId can be both a teacher (User) and a
// student (Student) — this remembers which menu to show by default so switching
// to the student menu sticks across messages.
model LineAccount {
  lineUserId        String       @id
  menuMode          LineMenuMode @default(TEACHER)
  // The student the account last selected in LIFF, so the LINE bot's menu shows
  // the same one. Plain id (no FK) — webhook re-validates ownership before use.
  selectedStudentId Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

// 續卡提醒的推播紀錄。刻意獨立於 `Event`——`GET /api/students/[id]/events` 會把
// 所有 event 畫在學生頁時間軸上，推播紀錄放進去會污染 UI。這張表只服務冷卻判定。
model RenewalReminder {
  id            Int      @id @default(autoincrement())
  studentId     Int
  student       Student  @relation(fields: [studentId], references: [id])
  // 觸發這次推播的那張用完的卡，僅供追查；卡之後被轉換／過期也不影響冷卻判定。
  studentCardId Int?
  sentAt        DateTime @default(now())

  // 冷卻查的是「這位學生最近一次推播是什麼時候」，排序欄位跟著進索引，
  // 和 Event 的 [studentId, createdAt] 同一個道理。
  @@index([studentId, sentAt])
}

// App（mobile/）註冊的 Expo push token。token 是裝置層級的：同一支手機換帳號登入時，
// 這列改掛到新的 user 身上，不會兩個帳號收到同一支手機的通知。
model PushToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  platform  String // "ios" | "android"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // App 每次啟動都會重新註冊，等於「最後一次看到」

  @@index([userId])
}

// 瀏覽器的 Web Push 訂閱（網頁版推播；App 走上面的 PushToken）。一個瀏覽器一列，
// endpoint 是瀏覽器推播服務給的網址，p256dh/auth 是加密用的金鑰，見 src/lib/webPush.ts。
model WebPushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// 老師對某間教室某類推播的開關。沒有這列 = 預設開啟，所以只存「關掉」或改過的。
model NotificationPreference {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  classroomId Int
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  type        TodoType
  enabled     Boolean
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, classroomId, type])
  @@index([classroomId])
}
